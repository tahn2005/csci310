<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone" />

            <!-- Ride post (FR-2.4) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/activityChip"
                            style="@style/Widget.TrojanRideshare.StatusChip" />

                        <TextView
                            android:id="@+id/capacityChip"
                            style="@style/Widget.TrojanRideshare.StatusChip"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/organizer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="?attr/selectableItemBackground"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="@color/cardinal"
                        app:drawableStartCompat="@drawable/ic_person"
                        app:drawableTint="@color/cardinal" />

                    <TextView
                        android:id="@+id/origin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:drawablePadding="8dp"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        app:drawableStartCompat="@drawable/ic_trip_origin"
                        app:drawableTint="@color/cardinal" />

                    <TextView
                        android:id="@+id/destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:drawablePadding="8dp"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        app:drawableStartCompat="@drawable/ic_place"
                        app:drawableTint="@color/cardinal" />

                    <TextView
                        android:id="@+id/when"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:drawablePadding="8dp"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        app:drawableStartCompat="@drawable/ic_event"
                        app:drawableTint="@color/ink_muted" />

                    <TextView
                        android:id="@+id/riders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:drawablePadding="8dp"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        app:drawableStartCompat="@drawable/ic_group"
                        app:drawableTint="@color/ink_muted" />

                    <TextView
                        android:id="@+id/cost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:drawablePadding="8dp"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        app:drawableStartCompat="@drawable/ic_money"
                        app:drawableTint="@color/ink_muted" />

                    <TextView
                        android:id="@+id/note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_status"
                        android:padding="10dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Actions -->
            <LinearLayout
                android:id="@+id/actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/reason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_notice"
                    android:padding="10dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/requestJoin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Request to Join"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancelRequest"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cancel My Request"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/markCompleted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mark as Completed"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editDeparture"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Edit Ride"
                    android:visibility="gone"
                    app:icon="@drawable/ic_edit" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/leaveRide"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Leave Ride"
                    android:textColor="@color/danger"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancelRide"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cancel Ride"
                    android:textColor="@color/danger"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Pending requests (organizer only, FR-3.8) -->
            <LinearLayout
                android:id="@+id/pendingSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/pendingHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:text="Pending requests"
                    android:textAppearance="@style/TextAppearance.TrojanRideshare.Section" />

                <TextView
                    android:id="@+id/pendingEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:text="No pending requests."
                    android:textColor="@color/ink_muted" />

                <LinearLayout
                    android:id="@+id/pendingList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Cost split (FR-4.5 – FR-4.7) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/costCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cost split"
                        android:textAppearance="@style/TextAppearance.TrojanRideshare.Section" />

                    <TextView
                        android:id="@+id/costSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/ink_muted" />

                    <LinearLayout
                        android:id="@+id/sharesList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/markPaid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="I've Paid My Share"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Riders -->
            <TextView
                android:id="@+id/ridersHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:text="Riders"
                android:textAppearance="@style/TextAppearance.TrojanRideshare.Section" />

            <LinearLayout
                android:id="@+id/ridersList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
